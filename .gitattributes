# AgriConnect - normalize line endings for cross-platform + container safety
# Unix shell scripts and Apache/PHP configs MUST be LF; CRLF breaks them at runtime.
* text=auto

*.sh     text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.htaccess text eol=lf

# Keep image/media as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
